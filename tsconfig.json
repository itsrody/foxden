{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true
	},
	"include": ["src/**/*.js", "types/**/*.d.ts"]
}
