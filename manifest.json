{
	"manifest_version": 2,
	"name": "JSLibCache",
	"version": "0.0.3",
	"default_locale": "en",
	"browser_specific_settings": {
		"gecko": {
			"id": "jslibcache@pass.dog"
		}
	},
	"description": "__MSG_description__",
	"icons": { "128": "icon256.png" },
	"permissions": [
		"*://*/*",
		"storage",
		"unlimitedStorage",
		"webRequest",
		"webRequestBlocking"
	],
	"background": {
		"scripts": ["utils.js", "background.js"]
	},
	"browser_action": {
		"default_popup": "popup.html",
		"browser_style": false
	}
}
